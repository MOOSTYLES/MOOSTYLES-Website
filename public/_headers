#############################################
# SEO & Performance Headers
#############################################

# Static Assets - Cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Images - Cache for 30 days
/projects/*
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff

# HTML Pages - SEO & Caching Optimized
/*
  Cache-Control: public, max-age=3600
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-UA-Compatible: IE=Edge

# XML Sitemaps & Robots - No cache
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=604800
  Content-Type: text/plain; charset=utf-8

# RSS/Feed files
/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Web App Manifest
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Internal build artifact - no client caching, no indexing
/.prerender-manifest.json
  Cache-Control: no-store
  X-Robots-Tag: noindex

# JSON files (except service worker)
/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

#############################################
# SECURITY: Block dangerous file types
#############################################
/*.config
/*.conf
/*.ini
/*.log
/*.sql
/*.db
/*.sqlite
/*.sqlite3
/*.bak
/*.backup
/*.tmp
/*.temp
/*.old
/*.orig
/*.swp
/*.swo
/*.exe
/*.bat
/*.cmd
/*.sh
/*.ps1
/*.py
/*.php
/*.asp
/*.jsp
/*.key
/*.pem
/*.p12
/*.pfx
/*.crt
/*.cer
/*.der
  X-Content-Type-Options: nosniff
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate

# SECURITY: Block system files
/.htaccess
/.htpasswd
/.DS_Store
/Thumbs.db
/desktop.ini
/.gitignore
/.gitattributes
  X-Content-Type-Options: nosniff
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate

# SECURITY: Block development directories
/node_modules/*
/src/*
/dist/*
/build/*
/.git/*
/.svn/*
/.hg/*
/.bzr/*
/vendor/*
/cache/*
/tmp/*
/temp/*
  X-Content-Type-Options: nosniff
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate

# Security headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://www.gstatic.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://www.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://formspree.io https://*.googlesyndication.com https://cloudflareinsights.com; frame-src https://*.doubleclick.net https://*.googlesyndication.com https://www.google.com; frame-ancestors 'none'; form-action 'self' https://formspree.io; upgrade-insecure-requests

# CMS admin panel - its own scoped CSP (needs to load the editor bundle from
# unpkg and talk to the GitHub API + the OAuth worker). Noindex so it never
# shows up in search results.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: https://api.github.com https://github.com https://*.githubusercontent.com https://unpkg.com https://cdn.jsdelivr.net https://*.workers.dev; worker-src 'self' blob:; frame-ancestors 'none'; form-action 'self'
